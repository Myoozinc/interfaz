# ==============================================================================
# NONA AI Software Factory - Environment Variables Configuration
# ==============================================================================
# Configure these variables in your Vercel Project Settings (Settings -> Environment Variables)
# or in a local .env.local file for local development with `vercel dev`.
#
# NONA Cloud Engine features intelligent multi-provider routing & automatic 429 failover.
# Users do NOT need to enter any API keys in the client UI when these are set on the backend.

# 1. Groq LPU (Ultra high-speed inference for Qwen 3.8 / Llama 3.3)
# Get your key free at: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: Multiple Groq keys for automatic load balancing (comma-separated)
# GROQ_API_KEYS=gsk_key1,gsk_key2

# 2. SambaNova Cloud (High-speed 16k context Qwen / Llama 3.3 inference tier)
# Get your key free at: https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=
# SAMBANOVA_API_KEYS=sn_key1,sn_key2

# 3. Cerebras Cloud (Ultra-fast wafer-scale Llama 3.3 70B inference tier)
# Get your key free at: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# CEREBRAS_API_KEYS=csk-key1,csk-key2

# 4. Google Gemini API (Multimodal UI analysis & high-fidelity code reasoning)
# Get your key free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_API_KEYS=AIzaSy...1,AIzaSy...2

# 5. OpenRouter API (Multi-model router & fallback engine)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
