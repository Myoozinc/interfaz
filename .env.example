# ==============================================================================
# NONA AI Software Factory - Environment Variables Configuration
# ==============================================================================
# Configure these variables in your Vercel Project Settings (Settings -> Environment Variables)
# or in a local .env.local file for local development with `vercel dev`.

# 1. Groq API Key (High-speed inference engine for Qwen 3.8 27B & GPT-OSS)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Multiple Groq keys for automatic rotation & load balancing (comma-separated)
# GROQ_API_KEYS=gsk_key1,gsk_key2

# 2. OpenRouter API Key (Multi-model router & fallback engine)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. Google Gemini API Key (Multimodal vision analysis for UI screenshots)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
